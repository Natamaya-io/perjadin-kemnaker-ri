# Environment Configuration
# Copy this file to .env and adjust values as needed.

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
# If running DB on host machine, use 'host.docker.internal' (Windows/Mac) or '172.17.0.1' (Linux)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=perjadin_db
DB_SSLMODE=disable

# ==============================================
# Redis Configuration
# ==============================================
# In docker-compose, this usually points to the service name 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# Backend Application (Go)
# ==============================================
APP_PORT=8081
# Secret key for JWT signing. Change this in production!
JWT_SECRET=supersecretkey_change_me_in_production
# Enable database seeding on startup (true/false)
SEED_DB=true
# Gin Mode (debug, release, test)
GIN_MODE=debug

# ==============================================
# Frontend Application (SvelteKit)
# ==============================================
# Port exposed to the host machine
FRONTEND_PORT=3005
# Public API URL (accessible from browser)
PUBLIC_API_URL=/api/v1
# Internal API URL (accessible from SSR server to backend container)
INTERNAL_API_URL=http://backend:8081

# ==============================================
# Docker Compose Settings
# ==============================================
# Project name prefix for containers
COMPOSE_PROJECT_NAME=perjadin
