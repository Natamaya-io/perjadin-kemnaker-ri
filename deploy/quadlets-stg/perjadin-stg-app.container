[Unit]
Description=Backend Go API Service (Fat Container Monolith)
Requires=perjadin-stg-secrets.service
After=perjadin-stg-secrets.service

[Container]
ContainerName=perjadin-stg-app
Image=ghcr.io/natamaya-io/perjadin-kemnaker-ri-app:staging
EnvironmentFile=/dev/shm/perjadin_stg.env
Network=perjadin-stg.network
Volume=%h/.persistent/perjadin-kemnaker-ri/stg/backend_uploads:/app/uploads
Volume=%h/.persistent/perjadin-kemnaker-ri/stg/db_data:/var/lib/postgresql/data
Volume=%h/.persistent/perjadin-kemnaker-ri/stg/redis_data:/data
PublishPort=37211:8081

# Hardcoded non-secret envs specific to infrastructure routing
Environment=APP_PORT=8081
Environment=SEED_DB=true
Environment=ALLOW_CLEANUP=false

# Enable automatic pulling of latest image when systemd service starts/restarts
AutoUpdate=registry

[Service]
Restart=always
# Ensure graceful shutdown of the Go app
TimeoutStopSec=30

[Install]
WantedBy=default.target
