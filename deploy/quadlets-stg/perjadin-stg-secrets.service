[Unit]
Description=Fetch Perjadin Secrets from Doppler to RAM Disk
Before=perjadin-stg-db.service perjadin-stg-redis.service perjadin-stg-gotenberg.service perjadin-stg-app.service

[Service]
Type=oneshot
EnvironmentFile=/home/gatsu51/.doppler_stg_token
ExecStart=/bin/sh -c 'doppler secrets download -t $DOPPLER_TOKEN --no-file --format docker > /dev/shm/perjadin_stg.env && echo POSTGRES_USER=$(doppler secrets get DB_USER -t $DOPPLER_TOKEN --plain) >> /dev/shm/perjadin_stg.env && echo POSTGRES_PASSWORD=$(doppler secrets get DB_PASSWORD -t $DOPPLER_TOKEN --plain) >> /dev/shm/perjadin_stg.env && echo POSTGRES_DB=$(doppler secrets get DB_NAME -t $DOPPLER_TOKEN --plain) >> /dev/shm/perjadin_stg.env'
# Ensure /dev/shm/perjadin_stg.env has strict permissions so only the owner can read it
ExecStartPost=/bin/chmod 600 /dev/shm/perjadin_stg.env
RemainAfterExit=yes

[Install]
WantedBy=default.target
