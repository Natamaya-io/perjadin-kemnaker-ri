[Unit]
Description=Backend Go API Service (Fat Container Monolith)
Requires=perjadin-secrets.service
After=perjadin-secrets.service

[Container]
ContainerName=perjadin-app
Image=ghcr.io/natamaya-io/perjadin-kemnaker-ri-app:latest
EnvironmentFile=/dev/shm/perjadin.env
Network=perjadin.network
Volume=%h/.persistent/perjadin-kemnaker-ri/prod/backend_uploads:/app/uploads
Volume=%h/.persistent/perjadin-kemnaker-ri/prod/postgres_data:/var/lib/postgresql/data
Volume=%h/.persistent/perjadin-kemnaker-ri/prod/redis_data:/data
PublishPort=8081:8081

# Hardcoded non-secret envs specific to infrastructure routing
Environment=APP_PORT=8081
Environment=SEED_DB=true
Environment=ALLOW_CLEANUP=false

# Override Doppler for Monolith
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=5432
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379

AutoUpdate=registry

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=default.target
