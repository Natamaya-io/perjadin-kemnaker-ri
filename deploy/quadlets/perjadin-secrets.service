[Unit]
Description=Fetch Perjadin Secrets from Doppler to RAM Disk
Before=perjadin-db.service perjadin-redis.service perjadin-gotenberg.service perjadin-backend.service perjadin-frontend.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'doppler secrets download --no-file --format env > /dev/shm/perjadin.env'
# Ensure /dev/shm/perjadin.env has strict permissions so only the owner can read it
ExecStartPost=/bin/chmod 600 /dev/shm/perjadin.env
RemainAfterExit=yes

[Install]
WantedBy=default.target
